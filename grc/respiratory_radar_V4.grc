- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nfrom gnuradio import gr\n\nclass blk(gr.sync_block):\n\
      \    \"\"\"Phase unwrap: removes +/-2*pi discontinuities\"\"\"\n    def __init__(self):\n\
      \        gr.sync_block.__init__(\n            self,\n            name='Phase\
      \ Unwrap',\n            in_sig=[np.float32],\n            out_sig=[np.float32])\n\
      \        self.last_in = 0.0\n        self.accum = 0.0\n\n    def work(self,\
      \ input_items, output_items):\n        x = input_items[0]\n        out = output_items[0]\n\
      \        # running unwrap: track cumulative offset\n        diff = np.diff(np.concatenate(([self.last_in],\
      \ x)))\n        # wrap each diff into [-pi, pi]\n        diff_wrapped = (diff\
      \ + np.pi) % (2*np.pi) - np.pi\n        # reconstruct unwrapped signal\n   \
      \     unwrapped = self.accum + np.cumsum(diff_wrapped)\n        out[:] = unwrapped.astype(np.float32)\n\
      \        # update state for next call\n        self.last_in = float(x[-1])\n\
      \        self.accum = float(unwrapped[-1])\n        return len(out)"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: '(''Phase Unwrap'', ''blk'', [], [(''0'', ''float'', 1)], [(''0'',
      ''float'', 1)], ''Phase unwrap: removes +/-2*pi discontinuities'', [])'
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1936, 304.0]
    rotation: 0
    state: enabled
- name: epy_block_0_0
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nfrom gnuradio import gr\n\nclass blk(gr.sync_block):\n\
      \    \"\"\"Phase unwrap: removes +/-2*pi discontinuities\"\"\"\n    def __init__(self):\n\
      \        gr.sync_block.__init__(\n            self,\n            name='Phase\
      \ Unwrap',\n            in_sig=[np.float32],\n            out_sig=[np.float32])\n\
      \        self.last_in = 0.0\n        self.accum = 0.0\n\n    def work(self,\
      \ input_items, output_items):\n        x = input_items[0]\n        out = output_items[0]\n\
      \        # running unwrap: track cumulative offset\n        diff = np.diff(np.concatenate(([self.last_in],\
      \ x)))\n        # wrap each diff into [-pi, pi]\n        diff_wrapped = (diff\
      \ + np.pi) % (2*np.pi) - np.pi\n        # reconstruct unwrapped signal\n   \
      \     unwrapped = self.accum + np.cumsum(diff_wrapped)\n        out[:] = unwrapped.astype(np.float32)\n\
      \        # update state for next call\n        self.last_in = float(x[-1])\n\
      \        self.accum = float(unwrapped[-1])\n        return len(out)"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: '(''Phase Unwrap'', ''blk'', [], [(''0'', ''float'', 1)], [(''0'',
      ''float'', 1)], ''Phase unwrap: removes +/-2*pi discontinuities'', [])'
